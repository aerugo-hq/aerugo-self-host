<mxfile host="app.diagrams.net" agent="Aerugo architecture generator" version="24.0.0"><diagram id="page1" name="1. The big picture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Aerugo: the company's living memory" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry" /></mxCell><mxCell id="v2" value="It reads what the company already has, understands how it fits together, and answers anyone in their own context: with evidence, and only what they're allowed to see. People correct it, and it learns. It's a senior colleague's memory and legwork, available to everyone, at any hour." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="48" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;Where knowledge lives today&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="300" height="30" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;Documents&lt;/b&gt;&lt;br&gt;Confluence, SharePoint, Drive" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="170" width="260" height="64" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;Tickets&lt;/b&gt;&lt;br&gt;Jira, ServiceNow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="252" width="260" height="64" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;Conversations&lt;/b&gt;&lt;br&gt;Teams, Slack, meetings" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="334" width="260" height="64" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;Code&lt;/b&gt;&lt;br&gt;GitHub repositories" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="416" width="260" height="64" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;Data&lt;/b&gt;&lt;br&gt;EDW, BigQuery, catalogs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="498" width="260" height="64" as="geometry" /></mxCell><mxCell id="v9" value="&lt;b&gt;Jobs&lt;/b&gt;&lt;br&gt;Control-M, Airflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="260" height="64" as="geometry" /></mxCell><mxCell id="v10" value="&lt;b&gt;People&lt;/b&gt;&lt;br&gt;the directory (Entra, Okta)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="662" width="260" height="64" as="geometry" /></mxCell><mxCell id="v11" value="&lt;b&gt;Operations&lt;/b&gt;&lt;br&gt;monitoring, incidents" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="744" width="260" height="64" as="geometry" /></mxCell><mxCell id="v12" value="Aerugo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eef3fb;strokeColor=#6c8ebf;strokeWidth=2;verticalAlign=top;align=center;spacingTop=6;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="470" y="170" width="640" height="640" as="geometry" /></mxCell><mxCell id="v13" value="&lt;b&gt;Knowledge core&lt;/b&gt;&lt;br&gt;what the company knows: facts, procedures, policies, contacts, definitions, decisions, lessons. Each with its evidence, owner, who it applies to, and how fresh it is." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="220" width="580" height="110" as="geometry" /></mxCell><mxCell id="v14" value="&lt;b&gt;Atlas&lt;/b&gt;&lt;br&gt;how everything connects: systems, code, jobs, tables, who uses what, what feeds what." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="350" width="580" height="90" as="geometry" /></mxCell><mxCell id="v15" value="&lt;b&gt;Architect agent and playbooks&lt;/b&gt;&lt;br&gt;thinks in steps, like a senior: traces a flow, plans a migration, walks a procedure, finds the right person." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="460" width="580" height="90" as="geometry" /></mxCell><mxCell id="v16" value="&lt;b&gt;Answers and guidance&lt;/b&gt;&lt;br&gt;search and Ask today; incident mode, onboarding paths, migration plans, proposed pull requests next." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="570" width="580" height="90" as="geometry" /></mxCell><mxCell id="v17" value="&lt;b&gt;On everything:&lt;/b&gt; permissions from each source, evidence for every claim, an audit trail, no monitoring of people" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="500" y="690" width="580" height="90" as="geometry" /></mxCell><mxCell id="v18" value="&lt;b&gt;Where people meet it&lt;/b&gt;" style="text;html=1;fontSize=14;align=center;" vertex="1" parent="1"><mxGeometry x="1250" y="130" width="340" height="30" as="geometry" /></mxCell><mxCell id="v19" value="&lt;b&gt;The web app&lt;/b&gt;&lt;br&gt;ask, explore, review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="190" width="300" height="76" as="geometry" /></mxCell><mxCell id="v20" value="&lt;b&gt;Teams and Slack&lt;/b&gt;&lt;br&gt;ask and save where they already talk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="300" width="300" height="76" as="geometry" /></mxCell><mxCell id="v21" value="&lt;b&gt;Phones and handhelds&lt;/b&gt;&lt;br&gt;stores and distribution centers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="410" width="300" height="76" as="geometry" /></mxCell><mxCell id="v22" value="&lt;b&gt;IDE and pull requests&lt;/b&gt;&lt;br&gt;impact while coding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="520" width="300" height="76" as="geometry" /></mxCell><mxCell id="v23" value="&lt;b&gt;APIs and agents (MCP)&lt;/b&gt;&lt;br&gt;other tools build on it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1270" y="630" width="300" height="76" as="geometry" /></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v4" target="v12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v5" target="v12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;ro