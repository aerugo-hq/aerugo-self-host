id="v20" value="Consolidation: merge, supersede, conflicts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="393.2857142857143" y="490" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v21" value="Analyzers: code, SQL lineage, usage, jobs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="562.4285714285714" y="490" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v22" value="Profiles and systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="731.5714285714286" y="490" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v23" value="Lifecycle: review, staleness, retirement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900.7142857142857" y="490" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v24" value="Learning loop: feedback, gaps, experts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1069.857142857143" y="490" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v25" value="Stores: what it keeps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="1200" height="140" as="geometry" /></mxCell><mxCell id="v26" value="Documents and index (Postgres, pgvector)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55.0" y="650" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v27" value="Knowledge units" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="224.14285714285714" y="650" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v28" value="Atlas graph" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="393.2857142857143" y="650" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v29" value="Questions and gaps" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="562.4285714285714" y="650" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v30" value="Usage" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="731.5714285714286" y="650" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v31" value="Permissions (OpenFGA)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900.7142857142857" y="650" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v32" value="Credentials (OpenBao, Secret Manager)" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1069.857142857143" y="650" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v33" value="Connectors and capture: how it reads" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="770" width="1200" height="140" as="geometry" /></mxCell><mxCell id="v34" value="Docs: Confluence, Drive, SharePoint, Notion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55.0" y="810" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v35" value="Tickets and chat: Jira, Slack, Slack capture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="224.14285714285714" y="810" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v36" value="Teams channels and capture" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="393.2857142857143" y="810" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v37" value="Meetings, handovers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="562.4285714285714" y="810" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v38" value="Code: GitHub (thousands of repos)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="731.5714285714286" y="810" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v39" value="Warehouses, catalogs, usage logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="900.7142857142857" y="810" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="v40" value="Schedulers and ETL: Control-M, Airflow" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1069.857142857143" y="810" width="155.14285714285714" height="80" as="geometry" /></mxCell><mxCell id="e41" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v34" target="v26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v26" target="v18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e43" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v18" target="v11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v11" target="v4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v45" value="&lt;b&gt;Across every layer&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1280" y="130" width="330" height="780" as="geometry" /></mxCell><mxCell id="v46" value="Identity: sign-on, and the asker's role and place" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="175" width="290" height="64" as="geometry" /></mxCell><mxCell id="v47" value="Permissions: row-level security and OpenFGA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="263" width="290" height="64" as="geometry" /></mxCell><mxCell id="v48" value="Model gateway: approved models, budgets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="351" width="290" height="64" as="geometry" /></mxCell><mxCell id="v49" value="Audit and privacy" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="439" width="290" height="64" as="geometry" /></mxCell><mxCell id="v50" value="Job queue with leases" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="527" width="290" height="64" as="geometry" /></mxCell><mxCell id="v51" value="Observability: telemetry, alerts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="615" width="290" height="64" as="geometry" /></mxCell><mxCell id="v52" value="Sensitive-topic filters" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="703" width="290" height="64" as="geometry" /></mxCell><mxCell id="v53" value="Question sets: tests for answers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="791" width="290" height="64" as="geometry" /></mxCell><mxCell id="v54" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1079" width="60" height="24" as="geometry" /></mxCell><mxCell id="v55" value="Built today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v56" value="To build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v57" value="The company's systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v58" value="Where people meet it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v59" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1079" width="160" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page3" name="3. What's stored"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Data residency: does Aerugo keep a copy?" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry" /></mxCell><mxCell id="v2" value="The sources stay the system of record: people keep writing in Confluence, Jira, and the rest. Aerugo can keep a full searchable copy, only pointers plus small derived facts, or nothing but pointers, chosen source by source. Everything it keeps stays inside the company's own cloud and region." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="48" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;A. Index&lt;/b&gt; (today)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="470" height="470" as="geometry" /></mxCell><mxCell id="v4" value="&amp;#10003; Pointer and metadata (title, address, owner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="175" width="430" height="48" as="geometry" /></mxCell><mxCell id="v5" value="&amp;#10003; Who may read it (permissions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="237" width="430" height="48" as="geometry" /></mxCell><mxCell id="v6" value="&amp;#10003; Small derived facts with pointers (the map, knowledge units)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="299" width="430" height="48" as="geometry" /></mxCell><mxCell id="v7" value="&amp;#10003; Embeddings (numbers that capture meaning)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="361" width="430" height="48" as="geometry" /></mxCell><mxCell id="v8" value="&amp;#10003; Text passages (a copy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="423" width="430" height="48" as="geometry" /></mxCell><mxCell id="v9" value="&lt;b&gt;Best answers, fastest.&lt;/b&gt; Works when a source is down. A protected copy of text exists: encrypted, permission-checked, deleted when the source deletes it." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="80" y="490" width="430" height="96" as="geometry" /></mxCell><mxCell id="v10" value="&lt;b&gt;B. Pointer&lt;/b&gt; (built for Confluence, Jira, and Slack)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="560" y="130" width="470" height="470" as="geometry" /></mxCell><mxCell id="v11" value="&amp;#10003; Pointer and metadata (title, address, owner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="175" width="430" height="48" as="geometry" /></mxCell><mxCell id="v12" value="&amp;#10003; Who may read it (permissions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="237" width="430" height="48" as="geometry" /></mxCell><mxCell id="v13" value="&amp;#10003; Small derived facts with pointers (the map, knowledge units)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="299" width="430" height="48" as="geometry" /></mxCell><mxCell id="v14" value="&amp;#10003; Embeddings (numbers that capture meaning)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="361" width="430" height="48" as="geometry" /></mxCell><mxCell id="v15" value="&amp;#10007; Text passages (a copy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontColor=#aaaaaa;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="423" width="430" height="48" as="geometry" /></mxCell><mxCell id="v16" value="&lt;b&gt;No second copy of content.&lt;/b&gt; Text is fetched from the source at answer time and thrown away after. Slower, and depends on the source being up. Embeddings still reveal meaning: protect them." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="580" y="490" width="430" height="96" as="geometry" /></mxCell><mxCell id="v17" value="&lt;b&gt;C. Live only&lt;/b&gt; (built for Confluence and Jira)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1060" y="130" width="470" height="470" as="geometry" /></mxCell><mxCell id="v18" value="&amp;#10003; Pointer and metadata (title, address, owner)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="175" width="430" height="48" as="geometry" /></mxCell><mxCell id="v19" value="&amp;#10003; Who may read it (permissions)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="237" width="430" height="48" as="geometry" /></mxCell><mxCell id="v20" value="&amp;#10007; Small derived facts with pointers (the map, knowledge units)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontColor=#aaaaaa;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="299" width="430" height="48" as="geometry" /></mxCell><mxCell id="v21" value="&amp;#10007; Embeddings (numbers that capture meaning)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontColor=#aaaaaa;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="361" width="430" height="48" as="geometry" /></mxCell><mxCell id="v22" value="&amp;#10007; Text passages (a copy)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontColor=#aaaaaa;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="423" width="430" height="48" as="geometry" /></mxCell><mxCell id="v23" value="&lt;b&gt;Almost nothing stored.&lt;/b&gt; Uses each source's own search when someone asks. Weakest answers, slowest, and no map of how things connect." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="1080" y="490" width="430" height="96" as="geometry" /></mxCell><mxCell id="v24" value="&lt;b&gt;How B works when someone asks&lt;/b&gt;" style="text;html=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="630" width="600" height="30" as="geometry" /></mxCell><mxCell id="v25" value="Person asks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="680" width="225" height="70" as="geometry" /></mxCell><mxCell id="v26" value="Find candidates: pointers, embeddings, facts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="315" y="680" width="225" height="70" as="geometry" /></mxCell><mxCell id="v27" value="Check their permission in the source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="570" y="680" width="225" height="70" as="geometry" /></mxCell><mxCell id="v28" value="Fetch only the passages needed, live" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="825" y="680" width="225" height="70" as="geometry" /></mxCell><mxCell id="v29" value="Answer with citations" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="680" width="225" height="70" as="geometry" /></mxCell><mxCell id="v30" value="Discard the text: nothing kept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1335" y="680" width="225" height="70" as="geometry" /></mxCell><mxCell id="e31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v25" target="v26"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v26" target="v27"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v27" target="v28"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v28" target="v29"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v29" target="v30"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v36" value="&lt;b&gt;What can't be pointer-only:&lt;/b&gt; the map. &quot;Who uses this table&quot;, &quot;what feeds this report&quot;, &quot;which repos change together&quot; are worked out ahead of time, across thousands of sources, and kept as small facts with pointers back to their evidence. They're derived knowledge, not copies of documents, and they carry the same permissions as their sources." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="790" width="1490" height="90" as="geometry" /></mxCell><mxCell id="v37" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1079" width="60" height="24" as="geometry" /></mxCell><mxCell id="v38" value="Kept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v39" value="Not kept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#cccccc;fontColor=#aaaaaa;dashed=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v40" value="People" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v41" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v42" value="Aerugo" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1079" width="160" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page4" name="4. Answering a question"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="How a question gets answered" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry" /></mxCell><mxCell id="v2" value="Nine steps, in about the time it takes to read this. Every answer says where it came from and how sure it is, and it never uses anything the person isn't allowed to see." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="48" as="geometry" /></mxCell><mxCell id="v3" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="50" height="50" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;Ask&lt;/b&gt;&lt;br&gt;in Teams, the web app, a phone, or the IDE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="150" width="380" height="110" as="geometry" /></mxCell><mxCell id="v5" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="180" width="50" height="50" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;Who's asking&lt;/b&gt;&lt;br&gt;sign-in, their team, role, and location" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="150" width="380" height="110" as="geometry" /></mxCell><mxCell id="v7" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1060" y="180" width="50" height="50" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;Find&lt;/b&gt;&lt;br&gt;knowledge units first, then documents and the Atlas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="150" width="380" height="110" as="geometry" /></mxCell><mxCell id="v9" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="50" height="50" as="geometry" /></mxCell><mxCell id="v10" value="&lt;b&gt;Filter&lt;/b&gt;&lt;br&gt;only what this person may see, in the database itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="380" width="380" height="110" as="geometry" /></mxCell><mxCell id="v11" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="410" width="50" height="50" as="geometry" /></mxCell><mxCell id="v12" value="&lt;b&gt;Fetch&lt;/b&gt;&lt;br&gt;in pointer mode, the passages needed, live from the source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="380" width="380" height="110" as="geometry" /></mxCell><mxCell id="v13" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1060" y="410" width="50" height="50" as="geometry" /></mxCell><mxCell id="v14" value="&lt;b&gt;Think&lt;/b&gt;&lt;br&gt;a playbook's steps, with the company's approved model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="380" width="380" height="110" as="geometry" /></mxCell><mxCell id="v15" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="60" y="640" width="50" height="50" as="geometry" /></mxCell><mxCell id="v16" value="&lt;b&gt;Check&lt;/b&gt;&lt;br&gt;every claim against its evidence; drop what isn't supported" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="130" y="610" width="380" height="110" as="geometry" /></mxCell><mxCell id="v17" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="560" y="640" width="50" height="50" as="geometry" /></mxCell><mxCell id="v18" value="&lt;b&gt;Answer&lt;/b&gt;&lt;br&gt;citations, confidence, and both sides when teams disagree" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="630" y="610" width="380" height="110" as="geometry" /></mxCell><mxCell id="v19" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#6c8ebf;strokeColor=none;fontColor=#ffffff;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="1060" y="640" width="50" height="50" as="geometry" /></mxCell><mxCell id="v20" value="&lt;b&gt;Learn&lt;/b&gt;&lt;br&gt;&quot;this is wrong&quot;, or &quot;ask an expert&quot;: it gets better" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1130" y="610" width="380" height="110" as="geometry" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v4" target="v6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v6" target="v8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v8" target="v10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v10" target="v12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v12" target="v14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v14" target="v16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v16" target="v18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v18" target="v20"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v29" value="&lt;b&gt;Example.&lt;/b&gt; A store associate asks: &quot;A customer slipped near the entrance. What do I do?&quot; It answers with that store's incident procedure as a checklist, who to call by role (the manager on duty, the district manager, loss prevention), the form to fill in, and what not to do, citing the procedure's page and its owner." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="1490" height="90" as="geometry" /></mxCell><mxCell id="v30" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1079" width="60" height="24" as="geometry" /></mxCell><mxCell id="v31" value="Built today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v32" value="To build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v33" value="The company's systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v34" value="Where people meet it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v35" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1079" width="160" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page5" name="5. How it learns"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="The self-evolving loop" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry" /></mxCell><mxCell id="v2" value="It doesn't rewrite itself. Its knowledge, confirmations, and playbooks grow, and every change to how it answers is tested against real questions before it ships." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="48" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;Capture&lt;/b&gt;&lt;br&gt;documents, opted-in chats, meetings, handovers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="140" width="300" height="90" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;Propose&lt;/b&gt;&lt;br&gt;draft knowledge, with its evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="300" width="300" height="90" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;Confirm or correct&lt;/b&gt;&lt;br&gt;the owner decides; corrections are kept" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="560" width="300" height="90" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;Consolidate&lt;/b&gt;&lt;br&gt;merge duplicates, supersede old, flag conflicts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="720" width="300" height="90" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;Answer&lt;/b&gt;&lt;br&gt;people use it, in their own context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="560" width="300" height="90" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;Notice gaps&lt;/b&gt;&lt;br&gt;unanswered questions, stale or conflicting knowledge" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="240" y="300" width="300" height="90" as="geometry" /></mxCell><mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v6" target="v7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v7" target="v8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v8" target="v3"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v15" value="&lt;b&gt;Tests gate every change&lt;/b&gt;&lt;br&gt;per-team question sets, with right answers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="420" width="340" height="90" as="geometry" /></mxCell><mxCell id="v16" value="&lt;b&gt;The synthetic retailer&lt;/b&gt;&lt;br&gt;a company and its data estate with known right answers, loaded through the connectors" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="640" y="530" width="340" height="90" as="geometry" /></mxCell><mxCell id="v17" value="&lt;b&gt;Ask an expert&lt;/b&gt;: a gap goes to whoever knows; with their consent, their answer becomes knowledge for the next person." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="860" width="720" height="70" as="geometry" /></mxCell><mxCell id="v18" value="&lt;b&gt;Freshness&lt;/b&gt;: every piece of knowledge has a review schedule; stale pieces go back to their owners." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="830" y="860" width="720" height="70" as="geometry" /></mxCell><mxCell id="v19" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1079" width="60" height="24" as="geometry" /></mxCell><mxCell id="v20" value="Built today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v21" value="To build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v22" value="The company's systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v23" value="Where people meet it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v24" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1079" width="160" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page6" name="6. Capture"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Capturing what isn't written down" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry" /></mxCell><mxCell id="v2" value="Much of what seniors know lives in conversations. It's captured only where people choose, filtered for privacy, and confirmed by an owner before anyone relies on it." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="48" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;Teams channel&lt;/b&gt;, opted in by its owners" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="150" width="320" height="70" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;&quot;Save to Aerugo&quot;&lt;/b&gt; on any message" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="250" width="320" height="70" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;Slack channel&lt;/b&gt;, opted in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="320" height="70" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;Meeting transcripts&lt;/b&gt;, opted in by the organizer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="450" width="320" height="70" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;Handover interview&lt;/b&gt; when someone leaves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="550" width="320" height="70" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;Ask an expert&lt;/b&gt; when an answer is missing" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="650" width="320" height="70" as="geometry" /></mxCell><mxCell id="v9" value="&lt;b&gt;Privacy filters&lt;/b&gt;&lt;br&gt;only opted-in places&lt;br&gt;&quot;don't capture&quot; marks honored&lt;br&gt;direct messages never, by default&lt;br&gt;HR, medical, and legal matters excluded&lt;br&gt;personal data excluded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="520" y="300" width="320" height="220" as="geometry" /></mxCell><mxCell id="v10" value="&lt;b&gt;Proposed knowledge&lt;/b&gt;&lt;br&gt;a procedure, an answer, a decision, a contact, with the messages it came from" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="940" y="330" width="300" height="140" as="geometry" /></mxCell><mxCell id="v11" value="&lt;b&gt;The owner confirms or corrects&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="300" width="270" height="90" as="geometry" /></mxCell><mxCell id="v12" value="&lt;b&gt;Knowledge core&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="450" width="270" height="90" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v3" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v4" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v5" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v6" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v7" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v22" value="&lt;b&gt;Teams' rules:&lt;/b&gt; a channel's owners can consent to a bot reading all its messages. Group-chat delivery to bots is unreliable, and live notifications aren't available for private and shared channels, so capture rests on opted-in standard channels and the save action, never on watching chats." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="1490" height="80" as="geometry" /></mxCell><mxCell id="v23" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1079" width="60" height="24" as="geometry" /></mxCell><mxCell id="v24" value="Built today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v25" value="To build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v26" value="The company's systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v27" value="Where people meet it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v28" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1079" width="160" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page7" name="7. Engineering and data"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="The engineering and data pack: lineage, usage, migrations" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry" /></mxCell><mxCell id="v2" value="One pack among many. It maps how data and code actually move, ranks what matters by real usage, and plans migrations like a senior would: for example, an EDW cube to the cloud platform (EDP on GCP)." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="48" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;GitHub&lt;/b&gt;&lt;br&gt;repos, Terraform, conventions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="140" width="260" height="75" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;EDW&lt;/b&gt;&lt;br&gt;metadata, query logs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="245" width="260" height="75" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;Control-M&lt;/b&gt;&lt;br&gt;jobs, order, scripts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="350" width="260" height="75" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;Airflow, Composer&lt;/b&gt;&lt;br&gt;DAGs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="455" width="260" height="75" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;dbt, Dataform&lt;/b&gt;&lt;br&gt;models" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="260" height="75" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;Catalogs&lt;/b&gt;&lt;br&gt;Knowledge Catalog, Dataplex" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="665" width="260" height="75" as="geometry" /></mxCell><mxCell id="v9" value="&lt;b&gt;Analyzers&lt;/b&gt; (facts, no AI)&lt;br&gt;repo facts, SQL lineage,&lt;br&gt;usage, the job graph,&lt;br&gt;naming and Terraform conventions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="300" width="260" height="160" as="geometry" /></mxCell><mxCell id="v10" value="&lt;b&gt;Atlas&lt;/b&gt;&lt;br&gt;tables, jobs, repos, owners, usage, and every link, with evidence" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="740" y="320" width="260" height="120" as="geometry" /></mxCell><mxCell id="v11" value="&lt;b&gt;Architect agent&lt;/b&gt;&lt;br&gt;migration playbook" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="320" width="220" height="120" as="geometry" /></mxCell><mxCell id="v12" value="&lt;b&gt;Migration assessment&lt;/b&gt;&lt;br&gt;waves by dependency, ranked by usage; retire what's unused" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="160" width="240" height="90" as="geometry" /></mxCell><mxCell id="v13" value="&lt;b&gt;Lineage diagrams&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="280" width="240" height="90" as="geometry" /></mxCell><mxCell id="v14" value="&lt;b&gt;Step-by-step plan&lt;/b&gt;&lt;br&gt;schema, Terraform, catalog metadata, validation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="400" width="240" height="90" as="geometry" /></mxCell><mxCell id="v15" value="&lt;b&gt;Pull requests&lt;/b&gt;&lt;br&gt;reviewed and merged by people" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1360" y="520" width="240" height="90" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v3" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v4" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v5" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v6" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v7" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v8" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v9" target="v10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v10" target="v11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v11" target="v13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v11" target="v14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v11" target="v15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v28" value="&lt;b&gt;The question it answers:&lt;/b&gt; &quot;This EDW cube needs to move to EDP. How do we do it?&quot; What feeds it, what it feeds, who uses it and how often, how our repos and Terraform name and define things, how its metadata maps to the catalog, in what order to move it, how to prove the copy is right, and draft pull requests for each step." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="800" width="1490" height="90" as="geometry" /></mxCell><mxCell id="v29" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1079" width="60" height="24" as="geometry" /></mxCell><mxCell id="v30" value="Built today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v31" value="To build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v32" value="The company's systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v33" value="Where people meet it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v34" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1079" width="160" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page8" name="8. Security and trust"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Security and trust: what keeps it safe" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry" /></mxCell><mxCell id="v2" value="The same permissions as the sources, enforced in the database. Read-only toward every source. Every action is a person's decision. Nothing is used to watch people." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="48" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;A person&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="180" height="80" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;Sign-in&lt;/b&gt;&lt;br&gt;the company's identity provider; during a pilot, only onboarded teams" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="370" width="220" height="100" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;Aerugo&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="580" y="380" width="200" height="80" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;Permissions&lt;/b&gt;&lt;br&gt;mirrored from each source; checked in the database (row-level security) and OpenFGA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="220" width="320" height="100" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;Credentials&lt;/b&gt;&lt;br&gt;read-only service accounts; secrets only as references (OpenBao, Secret Manager)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="340" width="320" height="100" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;Models&lt;/b&gt;&lt;br&gt;only the company's approved ones, through the gateway, with budgets" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="460" width="320" height="100" as="geometry" /></mxCell><mxCell id="v9" value="&lt;b&gt;Audit&lt;/b&gt;&lt;br&gt;every read and action recorded" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="580" width="320" height="80" as="geometry" /></mxCell><mxCell id="v10" value="&lt;b&gt;The sources&lt;/b&gt;&lt;br&gt;read-only; written only by reviewed pull requests, in repos that opted in" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1260" y="340" width="320" height="100" as="geometry" /></mxCell><mxCell id="e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v3" target="v4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v5" target="v6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v5" target="v7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v5" target="v8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v5" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v7" target="v10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v18" value="&lt;b&gt;Never:&lt;/b&gt; ranking people by their questions or activity; capturing a channel nobody opted in; answering from something the asker can't see; merging a change by itself." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1490" height="70" as="geometry" /></mxCell><mxCell id="v19" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1079" width="60" height="24" as="geometry" /></mxCell><mxCell id="v20" value="Built today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v21" value="To build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v22" value="The company's systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v23" value="Where people meet it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v24" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1079" width="160" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page9" name="9. Where it runs"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Where it runs: inside the company's own cloud" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry" /></mxCell><mxCell id="v2" value="Self-hosted in the company's own project and region. Nothing goes to an outside vendor. Sources in the company's data centers are reached through a runner inside their network that only calls out." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="48" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;The company's GCP project&lt;/b&gt; (region pinned)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="380" y="140" width="860" height="560" as="geometry" /></mxCell><mxCell id="v4" value="&lt;b&gt;Kubernetes (GKE)&lt;/b&gt;&lt;br&gt;web app, API, worker, MCP server, permissions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="200" width="380" height="120" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;Cloud SQL&lt;/b&gt;&lt;br&gt;Postgres with pgvector" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="200" width="340" height="120" as="geometry" /></mxCell><mxCell id="v6" value="&lt;b&gt;Secret Manager&lt;/b&gt;&lt;br&gt;references only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="360" width="380" height="100" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;Vertex AI&lt;/b&gt;&lt;br&gt;models, in the same region" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="360" width="340" height="100" as="geometry" /></mxCell><mxCell id="v8" value="&lt;b&gt;Logging and monitoring&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="420" y="500" width="380" height="80" as="geometry" /></mxCell><mxCell id="v9" value="&lt;b&gt;Identity provider&lt;/b&gt;&lt;br&gt;Entra or Okta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="860" y="500" width="340" height="80" as="geometry" /></mxCell><mxCell id="v10" value="&lt;b&gt;Cloud sources&lt;/b&gt;&lt;br&gt;Confluence, GitHub, Teams, Slack" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="260" width="300" height="100" as="geometry" /></mxCell><mxCell id="v11" value="&lt;b&gt;The company's data centers&lt;/b&gt;&lt;br&gt;EDW, Control-M" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="300" width="300" height="100" as="geometry" /></mxCell><mxCell id="v12" value="&lt;b&gt;Runner&lt;/b&gt;&lt;br&gt;inside their network, calls out only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="300" height="90" as="geometry" /></mxCell><mxCell id="v13" value="&lt;b&gt;Employees&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="520" width="300" height="80" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v4" target="v5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v4" target="v7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v4" target="v6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="read-only, allowlisted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v4" target="v10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v11" target="v12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="outbound only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v12" target="v4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="single sign-on" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v13" target="v4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v21" value="&lt;b&gt;Data residency, answered:&lt;/b&gt; everything stays in the company's project and region; with pointer mode, not even a copy of documents' text is kept (tab 3)." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="760" width="1490" height="70" as="geometry" /></mxCell><mxCell id="v22" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1079" width="60" height="24" as="geometry" /></mxCell><mxCell id="v23" value="Built today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v24" value="To build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v25" value="The company's systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v26" value="Where people meet it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v27" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1079" width="160" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page10" name="10. How we build it"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="How we build it: foundations first" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry" /></mxCell><mxCell id="v2" value="Each phase is proven on a synthetic company with known right answers before anything touches real data, and reviewed before the next begins." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="48" as="geometry" /></mxCell><mxCell id="v3" value="&lt;b&gt;Phase 0&lt;/b&gt;&lt;br&gt;Production fixes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="280" height="160" as="geometry" /></mxCell><mxCell id="v4" value="&lt;i&gt;make what exists solid at scale&lt;/i&gt;" style="text;html=1;align=center;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="60" y="360" width="280" height="50" as="geometry" /></mxCell><mxCell id="v5" value="&lt;b&gt;Foundation&lt;/b&gt;&lt;br&gt;Knowledge core, learning loop, question sets, the synthetic company, the Atlas" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="370" y="180" width="280" height="160" as="geometry" /></mxCell><mxCell id="v6" value="&lt;i&gt;everything else stands on it&lt;/i&gt;" style="text;html=1;align=center;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="370" y="360" width="280" height="50" as="geometry" /></mxCell><mxCell id="v7" value="&lt;b&gt;Capture&lt;/b&gt;&lt;br&gt;Teams, Slack, meetings, handovers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="680" y="180" width="280" height="160" as="geometry" /></mxCell><mxCell id="v8" value="&lt;i&gt;what isn't written down&lt;/i&gt;" style="text;html=1;align=center;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="680" y="360" width="280" height="50" as="geometry" /></mxCell><mxCell id="v9" value="&lt;b&gt;Surfaces&lt;/b&gt;&lt;br&gt;Screens, Teams and Slack bots, the frontline view" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="990" y="180" width="280" height="160" as="geometry" /></mxCell><mxCell id="v10" value="&lt;i&gt;where people are&lt;/i&gt;" style="text;html=1;align=center;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="990" y="360" width="280" height="50" as="geometry" /></mxCell><mxCell id="v11" value="&lt;b&gt;Packs&lt;/b&gt;&lt;br&gt;Onboarding, incidents, policies, contact center, merchandising, supply chain, recalls, engineering and migration, leaders" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1300" y="180" width="280" height="160" as="geometry" /></mxCell><mxCell id="v12" value="&lt;i&gt;the scenarios, team by team&lt;/i&gt;" style="text;html=1;align=center;fontSize=12;fontColor=#555555;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1300" y="360" width="280" height="50" as="geometry" /></mxCell><mxCell id="e13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v3" target="v5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v5" target="v7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v7" target="v9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v9" target="v11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="v17" value="&lt;b&gt;Today&lt;/b&gt;: documents, permissions, search and Ask, connectors for Confluence, Jira, Drive, GitHub, Slack, Microsoft 365, Notion, catalogs, and directories, each syncing only what changed and surviving rate limits; the Map; the Terraform provider; Kubernetes manifests." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="1490" height="70" as="geometry" /></mxCell><mxCell id="v18" value="&lt;b&gt;Why foundations first:&lt;/b&gt; a connector only adds raw material. What makes it a senior's memory is the core that turns material into knowledge, keeps it fresh, and learns from people. Built once, every new connector and every new team's pack makes it smarter." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#ffffff;strokeColor=#999999;align=left;spacingLeft=8;spacingRight=8;fontSize=12;verticalAlign=top;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="60" y="580" width="1490" height="80" as="geometry" /></mxCell><mxCell id="v19" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1079" width="60" height="24" as="geometry" /></mxCell><mxCell id="v20" value="Built today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v21" value="To build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v22" value="The company's systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v23" value="Where people meet it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v24" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1079" width="160" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>