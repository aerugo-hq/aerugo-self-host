eometry relative="1" as="geometry" /></mxCell><mxCell id="e35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v12" target="v22"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;" edge="1" parent="1" source="v12" target="v23"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e37" value="people confirm, correct, ask: it learns" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#d6b656;strokeWidth=2;dashed=1;fontSize=11;fontColor=#8a6d00;" edge="1" parent="1" source="v20" target="v12"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1420" y="900" /><mxPoint x="790" y="900" /></Array></mxGeometry></mxCell><mxCell id="v38" value="&lt;b&gt;Key&lt;/b&gt;" style="text;html=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="1079" width="60" height="24" as="geometry" /></mxCell><mxCell id="v39" value="Built today" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="100" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v40" value="To build" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="275" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v41" value="The company's systems" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;fontSize=12;" vertex="1" parent="1"><mxGeometry x="450" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v42" value="Where people meet it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="625" y="1079" width="160" height="30" as="geometry" /></mxCell><mxCell id="v43" value="Security" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;" vertex="1" parent="1"><mxGeometry x="800" y="1079" width="160" height="30" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram id="page2" name="2. Components"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="v1" value="Inside Aerugo: the parts, layer by layer" style="text;html=1;align=left;verticalAlign=top;fontSize=22;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="1500" height="36" as="geometry" /></mxCell><mxCell id="v2" value="Read it bottom to top: connectors bring knowledge in, pipelines turn it into facts and knowledge, stores keep it with its permissions, services reason over it, and surfaces put it in front of people. The column on the right runs through every layer." style="text;html=1;align=left;verticalAlign=top;fontSize=13;whiteSpace=wrap;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="64" width="1540" height="48" as="geometry" /></mxCell><mxCell id="v3" value="Surfaces: where people meet it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;dashed=1;strokeColor=#999999;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="1200" height="140" as="geometry" /></mxCell><mxCell id="v4" value="Web app (Next.js)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="55.0" y="170" width="183.33333333333334" height="80" as="geometry" /></mxCell><mxCell id="v5" value="Slack bot: asks, capture, saves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b3