# Dev-only credentials for the local stack. Never reuse any of these anywhere real.
KL_OWNER_PASSWORD=owner-dev-only
KL_APP_PASSWORD=app-dev-only
KL_INGEST_PASSWORD=ingest-dev-only
KL_FGA_PASSWORD=fga-dev-only
OPENBAO_DEV_ROOT_TOKEN=dev-root-token      # the operator's, for OpenBao by hand; no service holds it
OPENBAO_SERVICES_TOKEN=dev-services-token  # the services' (G1): deploy/openbao/services.hcl, never root
KC_ADMIN_PASSWORD=admin-dev-only

# Host ports (all bound to 127.0.0.1). On Windows, if a port is refused with "forbidden by its
# access permissions", it is reserved: list reserved ranges with
#   netsh interface ipv4 show excludedportrange protocol=tcp
# and pick a free number here. OpenFGA isn't published at all; it's only used inside the network.
KL_API_PORT=8000
KL_KEYCLOAK_PORT=8081
KL_OPENBAO_PORT=8200
KL_POSTGRES_PORT=55432

# Optional: live model check through the registry (leave blank to skip).
# provider: openai_compatible | anthropic
# Ollama on your machine: provider=openai_compatible, base url http://host.docker.internal:11434/v1, any non-empty key
KL_SMOKE_PROVIDER=
KL_SMOKE_MODEL=
KL_SMOKE_BASE_URL=
KL_SMOKE_API_KEY=

# Optional: answer grading in `make eval` (slice M2). KL_EVAL_ASK_MODEL is a registered model, as
# '<workspace>/<name>'; each golden question with key facts is asked as its user, and members of
# other teams are skipped. The judge grades faithfulness and key facts; it reads only passages whose
# classification is in KL_EVAL_JUDGE_CLASSIFICATIONS. Leave the judge blank to check citations only.
KL_EVAL_ASK_MODEL=
KL_EVAL_JUDGE_PROVIDER=
KL_EVAL_JUDGE_MODEL=
KL_EVAL_JUDGE_BASE_URL=
KL_EVAL_JUDGE_API_KEY=
KL_EVAL_JUDGE_CLASSIFICATIONS=public,internal

# GitHub App: `make github-app ORG=<your-org>` creates it and writes .secrets/github-app.{pem,json}.
# Only set GITHUB_APP_ID if you created the App by hand. KL_SETUP_PORT is the local callback port.
GITHUB_APP_ID=
KL_SETUP_PORT=8765

# Your GitHub username. M1 maps it to the dev user alice, so the permission tests can prove alice
# sees exactly the repos GitHub lets you see, and users without a GitHub identity see none.
KL_DEV_GITHUB_LOGIN=

# Smoke's curator check opens a pull request in your sandbox's payments-knowledge repository and merges it: a real
# write to GitHub, adding a curated page there each run. Set to 1 to let it; blank skips it.
KL_SMOKE_GITHUB_WRITES=

# Backups (slice I4): the passphrase pgBackRest encrypts the backup repository with. Blank uses a dev default; set a
# long random value anywhere but a laptop, and keep it safe: backups can't be restored without it.
KL_BACKUP_CIPHER_PASS=
